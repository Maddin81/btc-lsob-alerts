# Kopiere diese Datei nach  .env  (liegt neben docker-compose.yml).
# Docker liest sie automatisch ein.
#
# Eine Variable je Kamera. Der Name ist frei waehlbar, er muss nur mit dem
# ${...} in der config.yaml uebereinstimmen.

CAM_HAUSTUER_PASS=
CAM_CARPORT_PASS=
CAM_GARTEN_PASS=

# Optional, nur wenn Telegram-Alarme aktiviert sind:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
